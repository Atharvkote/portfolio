{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*\\.(?:css|js|png|jpg|jpeg|svg|webp|ico|woff|woff2|map))",
      "headers": {
        "cache-control": "public, immutable, max-age=31536000"
      },
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}