# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Leave empty in development if you do not want to track local sessions.
VITE_GA_MEASUREMENT_ID=

# Canonical Production URL of your portfolio
VITE_SITE_URL=https://atharvakote.vercel.app

# Server-side Upstash Redis Database (Read exclusively by Vercel Serverless Functions)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret key used for signing visitor tracking cookies with HMAC-SHA256 (64 hex characters)
VISITOR_COOKIE_SECRET=

# Comma-separated list of allowed origins for the visitor counter endpoint
SITE_ORIGINS=https://atharvakote.vercel.app,http://localhost:5173,http://localhost:3000

